# HIDDEN INDIA — ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy to .env and configure for local development or production.
# IMPORTANT: Never commit actual secret keys or credentials to git.

# Server Settings
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# If not configured or unreachable, the server automatically uses local embedded database fallback.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hidden_india

# Razorpay Payment Gateway (TEST Mode credentials)
# Obtain test credentials from Razorpay Dashboard: Settings > API Keys
# Real booking mode requires valid test keys; Demo booking mode works without keys.
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Supplier Travel Inventory API
# If SUPPLIER_API_ENABLED is false, bookings show:
# "Payment may be processed, but travel reservation is not confirmed."
SUPPLIER_API_ENABLED=false
SUPPLIER_API_URL=https://api.example-supplier.com/v1
SUPPLIER_API_KEY=placeholder_supplier_key
